# Optional form delivery
# Set VITE_FORM_ENDPOINT to a JSON endpoint (Formspree, Web3Forms, Basin, etc.)
# to deliver enquiries directly to your inbox. Without it, forms hand off to
# WhatsApp / email so nothing is silently lost. See README.md.
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=

# Optional: your live domain (used for canonical + Open Graph URLs)
VITE_SITE_URL=
